<Window x:Class="OmniLauncher.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Border Background="#1E1E2E" CornerRadius="10"
            BorderBrush="#45475A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="20">

            <!-- Title -->
            <TextBlock Text="Settings" Foreground="#CBA6F7"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Form grid: label | control -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hotkey -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hotkey"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyBox" Grid.Column="0"
                             Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"
                             Padding="6,5" IsReadOnly="True"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus"/>
                    <Button x:Name="RecordBtn" Grid.Column="1" Content="Record"
                            Width="60" Margin="6,0,0,0"
                            Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                            Cursor="Hand" Click="RecordBtn_Click"/>
                </Grid>

                <!-- Theme -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Theme"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                          Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A">
                    <ComboBoxItem Content="Dark (Mocha)"  Tag="dark"/>
                    <ComboBoxItem Content="Light (Latte)" Tag="light"/>
                </ComboBox>

                <!-- Provider -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="AI Provider"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox x:Name="ProviderCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                          Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"
                          SelectionChanged="ProviderCombo_SelectionChanged">
                    <ComboBoxItem Content="OmniLLM (local)" Tag="omnillm" IsSelected="True"/>
                    <ComboBoxItem Content="OpenAI"          Tag="openai"/>
                    <ComboBoxItem Content="Azure OpenAI"    Tag="azure"/>
                    <ComboBoxItem Content="Custom"          Tag="custom"/>
                </ComboBox>

                <!-- Base URL -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Base URL"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="OmniLLMUrl" Grid.Row="3" Grid.Column="1"
                         Text="http://localhost:5000"
                         Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="6,5" Margin="0,0,0,10"/>

                <!-- API Key -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="API Key"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <PasswordBox x:Name="ApiKeyBox" Grid.Row="4" Grid.Column="1"
                             Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"
                             Padding="6,5" Margin="0,0,0,10"/>

                <!-- Model -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Model"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="OmniLLMModel" Grid.Row="5" Grid.Column="1"
                         Text="auto"
                         Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="6,5" Margin="0,0,0,10"/>

                <!-- Start on boot -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Start on boot"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <CheckBox x:Name="StartOnBoot" Grid.Row="6" Grid.Column="1"
                          Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Start hidden -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Start hidden"
                           Foreground="#7F849C" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <CheckBox x:Name="HideOnLaunch" Grid.Row="7" Grid.Column="1"
                          IsChecked="True" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </Grid>

            <!-- Divider -->
            <Separator Background="#45475A" Margin="0,12,0,12"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="72" Height="30" Margin="0,0,8,0"
                        Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                        Cursor="Hand" Click="CancelBtn_Click"/>
                <Button Content="Save" Width="72" Height="30"
                        Background="#CBA6F7" Foreground="#1E1E2E" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand" Click="SaveBtn_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
